<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Display">
        <ListPreference
            app:key="ui_scale"
            app:title="Interface Scale"
            app:entries="@array/ui_scale_entries"
            app:entryValues="@array/ui_scale_values"
            app:defaultValue="auto"
            app:summary="Hyprland and GTK/Qt applications" />

        <ListPreference
            app:key="refresh_mhz"
            app:title="Panel Refresh"
            app:entries="@array/refresh_entries"
            app:entryValues="@array/refresh_values"
            app:defaultValue="120000" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Graphics">
        <ListPreference
            app:key="gpu_mode"
            app:title="Graphics"
            app:entries="@array/gpu_mode_entries"
            app:entryValues="@array/gpu_mode_values"
            app:defaultValue="auto"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Storage">
        <ListPreference
            app:key="bind_sdcard_mode"
            app:title="Share Android storage"
            app:entries="@array/share_mode_entries"
            app:entryValues="@array/share_mode_values"
            app:defaultValue="auto"
            app:summary="@string/share_summary_auto_no_grant" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Advanced">
        <SwitchPreferenceCompat
            app:key="phantom_limit_fix"
            app:title="Lift Android's child-process limit"
            app:summary="Stops Android 12+ from killing desktop apps past 32 background processes. Needs the one-time adb grant from install.sh, otherwise the notification shows the command"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="show_terminal"
            app:title="Show Terminal Panel"
            app:summary="Pull-up terminal for shell access inside proot"
            app:defaultValue="false" />

        <EditTextPreference
            app:key="custom_startup"
            app:title="Custom Startup Script"
            app:summary="Path to script run instead of the Omarchy session (inside rootfs)" />

        <Preference
            app:key="reset_factory"
            app:title="Reset to Factory"
            app:summary="Re-extract the Omarchy rootfs from the bundled image" />
    </PreferenceCategory>

</PreferenceScreen>
