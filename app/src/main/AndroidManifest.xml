<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Read radio state for the guest UI; Android Settings owns connection changes. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- Broad access to /storage/emulated/0 so phosh/Nautilus can see the phone's
         Downloads, Pictures, Documents etc. User must toggle this in system
         settings after install. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- a5. Modern keyboard capture (Android 16.1 / API 36.1): while our window
         is focused it receives keys before the system processes its shortcuts,
         which is what Meta (SUPER) needs. protectionLevel="normal", so this line
         grants it at install; the platform ignores an unknown permission, and the
         call itself is reflection (compileSdk 35 has neither the permission
         constant nor the LayoutParams method). Termux:X11's accessibility
         KeyInterceptor stays in place as the fallback. -->
    <uses-permission android:name="android.permission.CAPTURE_KEYBOARD" />

    <application
        android:name=".PhoshdroidApp"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Phoshdroid"
        android:extractNativeLibs="true"
        tools:replace="android:theme">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="screenSize|screenLayout|smallestScreenSize|orientation|density|uiMode">
            <!-- singleTask so that re-tapping the launcher icon (or the FGS
                 notification) while bootstrap is in flight reuses the live
                 LauncherActivity — firing onNewIntent / onResume — instead
                 of spawning a second instance that races the X server. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".proot.ProotService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <!-- The guest's home in the system file picker (contract section 10). Declared the way
             the platform documents a custom documents provider: exported so the picker can see
             it, grantUriPermissions so the system can hand a document to another app, and
             MANAGE_DOCUMENTS so only the system can talk to it.
             https://developer.android.com/guide/topics/providers/create-document-provider -->
        <provider
            android:name=".storage.OmdroidDocumentsProvider"
            android:authorities="com.phoshdroid.app.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- Termux:X11 Wayland compositor activity (merged from termux-x11-app library).
             Override exported=false so it is not accessible outside this APK. -->
        <activity
            android:name="com.termux.x11.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            tools:replace="android:exported,android:launchMode">
            <!-- Samsung DeX / desktop mode: 0x0 launch bounds mean "full screen"
                 (developer.samsung.com/samsung-dex/modify-optional.html). Without
                 it DeX opens the desktop in a free-form window on the monitor. -->
            <meta-data
                android:name="com.samsung.android.dex.launchwidth"
                android:value="0" />
            <meta-data
                android:name="com.samsung.android.dex.launchheight"
                android:value="0" />
        </activity>

        <!-- The extra-keyboard gear opens this explicitly. Disabling it throws
             ActivityNotFoundException and kills the in-process desktop. It has
             no launcher filter and remains inaccessible to other apps. -->
        <activity
            android:name="com.termux.x11.LoriePreferences"
            android:enabled="true"
            android:exported="false"
            tools:replace="android:enabled" />

        <!-- Termux:X11's KeyInterceptor accessibility service, relabelled for this APK.
             The submodule declares it as "Termux:X11 KeyInterceptor", which is what
             Settings → Accessibility would show; the label here is the name the user sees
             when he allows restricted settings for the app, so it has to say Omdroid.
             Only the label is replaced: the intent-filter, the BIND_ACCESSIBILITY_SERVICE
             permission and the service config meta-data still come from the library. -->
        <service
            android:name="com.termux.x11.utils.KeyInterceptor"
            android:label="@string/key_capture_label"
            tools:replace="android:label" />

    </application>
</manifest>
